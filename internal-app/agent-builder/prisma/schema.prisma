generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user

  @@map("agent_builder_user_role")
}

model User {
  id              String        @id @default(uuid())
  username        String        @unique @db.VarChar(64)
  passwordHash    String        @map("password_hash")
  role            UserRole      @default(user)
  isBuiltIn       Boolean       @default(false) @map("is_built_in")
  avatarData      Bytes?        @map("avatar_data")
  avatarMime      String?       @map("avatar_mime") @db.VarChar(64)
  avatarUpdatedAt DateTime?     @map("avatar_updated_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        AuthSession[]
  projects        Project[]
  chatSessions    ChatSession[]

  @@map("agent_builder_users")
}

model AuthSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("agent_builder_auth_sessions")
}

model Project {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(300)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    ChatSession[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("agent_builder_projects")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  projectId String?       @map("project_id")
  title     String        @db.VarChar(200)
  files     Json          @default("[]")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([projectId, updatedAt(sort: Desc)])
  @@map("agent_builder_chat_sessions")
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String      @map("session_id")
  role          String      @db.VarChar(20)
  content       String      @db.Text
  artifactTitle String?     @map("artifact_title") @db.VarChar(200)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("agent_builder_chat_messages")
}

model ModelConfig {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  provider  String   @db.VarChar(64)
  icon      String   @default("openai") @db.VarChar(64)
  modelName String   @map("model_name") @db.VarChar(160)
  baseUrl   String   @map("base_url") @db.VarChar(500)
  apiKey    String   @map("api_key") @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isDefault, updatedAt(sort: Desc)])
  @@map("agent_builder_model_configs")
}
